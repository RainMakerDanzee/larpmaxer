{
  "name": "larpmaxer",
  "version": "0.1.0",
  "private": true,
  "description": "Fill job applications from a profile you own. Local-first, review-before-submit.",
  "license": "MIT",
  "author": "Daniyal Ahmed",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "typecheck": "tsc -b packages/core packages/extension",
    "e2e": "node packages/extension/e2e/run.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "playwright": "^1.56.0",
    "preact": "^10.29.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RainMakerDanzee/larpmaxer.git"
  },
  "bugs": {
    "url": "https://github.com/RainMakerDanzee/larpmaxer/issues"
  },
  "homepage": "https://github.com/RainMakerDanzee/larpmaxer#readme"
}
